   "type": "file"
  },
  {
   "id": "file:public/index.html",
   "name": "index.html",
   "filePath": "public/index.html",
   "summary": "Single-page Trident interface: sidebar of workplaces plus Library and Settings views, a Lead chat, a Needs-you approvals bar, the goal/task board, team talk, activity log and Ask-several comparison columns, all driven by an inline script that consumes the server's /events stream and posts actions back.",
   "type": "file"
  },
