{
 "nodes": [
  {
   "id": "file:src/claude.mjs",
   "name": "claude.mjs",
   "filePath": "src/claude.mjs",
   "summary": "Wraps the Claude Agent SDK query() into a long-lived, message-at-a-time Claude worker session whose run(text) resolves with the final reply; also builds a subscription-only environment that strips stray Anthropic API overrides.",
   "type": "file"
  },
  {
   "id": "file:src/compare.mjs",
   "name": "compare.mjs",
   "filePath": "src/compare.mjs",
   "summary": "Side-by-side model comparison node: sends one question to up to four sources (local Claude, local Codex, or any OpenRouter model) in parallel and emits their answers with timing and cost.",
   "type": "file"
  },
  {
   "id": "file:src/git.mjs",
   "name": "git.mjs",
   "filePath": "src/git.mjs",
   "summary": "Git plumbing for worker workspaces: initializes the workspace repo, creates per-task worktrees on their own branches, reports diffs, merges accepted branches, and removes worktrees, all committed under a local Trident identity.",
   "type": "file"
  },
  {
   "id": "file:src/library-tools.mjs",
   "name": "library-tools.mjs",
   "filePath": "src/library-tools.mjs",
   "summary": "Builds an in-process MCP server exposing list/read/write tools over the shared Markdown Library to Claude-harness agents, where writes become unsaved drafts the user approves.",
   "type": "file"
  },
  {
   "id": "file:src/talk-tools.mjs",
   "name": "talk-tools.mjs",
   "filePath": "src/talk-tools.mjs",
   "summary": "Builds an in-process MCP server with say/read team-talk tools for Claude-harness workers, plus a digest helper that surfaces unread board messages without ever waking other agents.",
   "type": "file"
  },
  {
   "id": "file:src/team.mjs",
   "name": "team.mjs",
   "filePath": "src/team.mjs",
   "summary": "Core worker-team orchestrator: assigns Lead tasks to Claude, Codex, or OpenRouter workers in isolated git worktrees, gates risky edits, broadcasts file-edit notes and clash warnings, runs cross-vendor review rounds, and merges or rejects results.",
   "type": "file"
  },
  {
   "id": "file:src/workplaces.mjs",
   "name": "workplaces.mjs",
   "filePath": "src/workplaces.mjs",
   "summary": "Manages multiple isolated workplaces (each with its own folder, board, Lead, team and compare node) persisted in data/workplaces.json, handling create, remove/archive, goal cancellation and folder validation.",
   "type": "file"
  },
  {
   "id": "file:src/codex.mjs",
   "name": "codex.mjs",
   "filePath": "src/codex.mjs",
   "summary": "Codex worker adapter that keeps one long-lived codex app-server process running and talks to it over JSON-RPC on stdio, giving the rest of Trident per-thread conversations, approval forwarding and out-of-usage tracking.",
   "type": "file"
  },
  {
   "id": "file:src/library.mjs",
   "name": "library.mjs",
   "filePath": "src/library.mjs",
   "summary": "The shared Markdown Library: a plain folder of notes in sections that every agent can read, where every change is first stored as a draft and only becomes the real note when the user saves it, with replaced versions kept under .old.",
   "type": "file"
  },
  {
   "id": "file:src/openrouter.mjs",
   "name": "openrouter.mjs",
   "filePath": "src/openrouter.mjs",
   "summary": "OpenRouter integration that reads the API key and model from the process or Windows user environment and builds the environment that points the Claude Agent SDK worker at OpenRouter's Anthropic-compatible endpoint, plus a no-cost key and model check.",
   "type": "file"
  },
  {
   "id": "file:src/server.mjs",
   "name": "server.mjs",
   "filePath": "src/server.mjs",
   "summary": "Trident's entry point: a local HTTP server bound to 127.0.0.1 that wires together the gate, Codex, OpenRouter, Library, settings and workplaces, streams every event to the page over server-sent events, and handles the POST routes for workplaces, messages, approvals, plans, interrupts, Library actions and settings.",
   "type": "file"
  },
  {
   "id": "file:src/settings.mjs",
   "name": "settings.mjs",
   "filePath": "src/settings.mjs",
   "summary": "Trident-wide settings store kept in data/settings.json, currently holding the maximum number of workers per workplace, with validation and a settings event on every change.",
   "type": "file"
  },
  {
   "id": "file:src/board-tools.mjs",
   "name": "board-tools.mjs",
   "filePath": "src/board-tools.mjs",
   "summary": "Defines the in-process MCP server of board tools the Lead agent calls (propose_plan, update_task, finish_goal, assign_task, accept_task, reject_task, ask_several, team_say), so the Lead changes the board and team only through validated tool calls.",
   "type": "file"
  },
  {
   "id": "file:src/board.mjs",
   "name": "board.mjs",
   "filePath": "src/board.mjs",
   "summary": "SQLite-backed board store (via node:sqlite) holding goals, their tasks and team talk; handles schema creation and column migrations, plan proposal, task updates, and renders the [state] block fed to the Lead.",
   "type": "file"
  },
  {
   "id": "file:src/gate.mjs",
   "name": "gate.mjs",
   "filePath": "src/gate.mjs",
   "summary": "Approval gate that holds an agent's risky tool calls until the user allows or denies them, persisting 'always allow' and 'always deny' rules per exact operation to a JSON file.",
   "type": "file"
  },
  {
   "id": "file:src/lead.mjs",
   "name": "lead.mjs",
   "filePath": "src/lead.mjs",
   "summary": "Runs the Lead agent as one long-lived Claude Agent SDK session fed by an async message queue, wiring in board and library MCP tools and the approval gate, and streaming its output as UI events; also exports a one-line tool-call summarizer.",
   "type": "file"
  },
  {
   "id": "file:.claude/autoharness/requests",
   "name": "requests",
   "filePath": ".claude/autoharness/requests",
   "summary": "Tiny runtime counter file used by the autoharness Claude Code plugin to queue skill-learning requests; it holds a single character and no project logic.",
   "type": "file"
  },
  {
   "id": "config:.claude/launch.json",
   "name": "launch.json",
   "filePath": ".claude/launch.json",
   "summary": "Claude Code launch configuration that starts the Trident engine with `node src/server.mjs` and points the preview at http://127.0.0.1:4317.",
   "type": "config"
  },
  {
   "id": "config:.ua/config.json",
   "name": "config.json",
   "filePath": ".ua/config.json",
   "summary": "Understand-Anything tool settings that fix the knowledge-graph output language to English.",
   "type": "config"
  },
  {
   "id": "document:README.md",
   "name": "README.md",
   "filePath": "README.md",
   "summary": "Project overview explaining Trident's Lead/worker/cross-check model, workplaces, Ask several, Library and approvals, plus requirements (Node 26, git, Claude/Codex logins), setup, optional OpenRouter keys, folder layout, work flow diagram, status and privacy notes.",
   "type": "document"
  },
  {
   "id": "document:docs/agent-collab-teardown.md",
