        11
      ],
      "summary": "Returns a copy of process.env with the Anthropic base URL, auth token and API key removed so Claude uses the user's own sign-in.",
      "tags": [
        "utility",
        "environment",
        "auth"
      ],
      "complexity": "simple"
    },
    {
      "id": "function:src/claude.mjs:claudeSession",
