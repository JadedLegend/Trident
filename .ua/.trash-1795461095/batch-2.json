    {
      "id": "file:src/codex.mjs",
      "type": "file",
      "name": "codex.mjs",
      "filePath": "src/codex.mjs",
      "summary": "Codex worker adapter that keeps one long-lived codex app-server process running and talks to it over JSON-RPC on stdio, giving the rest of Trident per-thread conversations, approval forwarding and out-of-usage tracking.",
      "tags": [
        "service",
        "agent-adapter",
        "json-rpc",
        "child-process",
        "codex"
      ],
      "complexity": "moderate",
      "languageNotes": "Uses a closure-based module (a factory function returning methods) instead of a class, with a Map of pending request promises keyed by JSON-RPC id."
    },
    {
      "id": "function:src/codex.mjs:startCodex",
      "type": "function",
      "name": "startCodex",
      "filePath": "src/codex.mjs",
      "lineRange": [
        29,
        138
      ],
      "summary": "Factory that lazily spawns the Codex app-server in isolation mode (global plugins and MCP servers disabled), routes JSON-RPC replies, events and permission requests to per-thread handlers, and exposes thread(), unavailableReason() and stop().",
      "tags": [
        "factory",
        "agent-adapter",
        "json-rpc",
        "event-handler"
      ],
      "complexity": "complex"
    },
    {
      "id": "file:src/library.mjs",
      "type": "file",
      "name": "library.mjs",
      "filePath": "src/library.mjs",
      "summary": "The shared Markdown Library: a plain folder of notes in sections that every agent can read, where every change is first stored as a draft and only becomes the real note when the user saves it, with replaced versions kept under .old.",
      "tags": [
        "service",
        "storage",
        "markdown",
        "drafts",
        "versioning"
      ],
      "complexity": "moderate"
    },
    {
      "id": "function:src/library.mjs:openLibrary",
      "type": "function",
      "name": "openLibrary",
      "filePath": "src/library.mjs",
      "lineRange": [
        33,
        168
      ],
      "summary": "Creates the Library folders and default guide, then returns snapshot, list, read, draft, save, discard, restore and deleteOld operations; paths are cleaned to stay inside the Library, and every change emits a library update event.",
      "tags": [
        "factory",
        "storage",
        "validation",
        "versioning"
      ],
      "complexity": "complex"
    },
    {
      "id": "file:src/openrouter.mjs",
      "type": "file",
      "name": "openrouter.mjs",
      "filePath": "src/openrouter.mjs",
      "summary": "OpenRouter integration that reads the API key and model from the process or Windows user environment and builds the environment that points the Claude Agent SDK worker at OpenRouter's Anthropic-compatible endpoint, plus a no-cost key and model check.",
      "tags": [
        "config",
        "integration",
        "openrouter",
        "environment"
      ],
      "complexity": "moderate"
    },
    {
      "id": "function:src/openrouter.mjs:setting",
      "type": "function",
      "name": "setting",
      "filePath": "src/openrouter.mjs",
      "lineRange": [
        12,
        21
      ],
      "summary": "Reads a named setting from process.env, falling back to the Windows user environment through PowerShell so values set with setx work without a reboot.",
      "tags": [
        "utility",
        "environment",
        "windows"
      ],
      "complexity": "simple"
    },
    {
      "id": "function:src/openrouter.mjs:openRouterConfig",
      "type": "function",
      "name": "openRouterConfig",
      "filePath": "src/openrouter.mjs",
      "lineRange": [
        23,
        57
      ],
      "summary": "Returns null when no OpenRouter key is set; otherwise returns the model, key, an env override mapping every Anthropic model slot to the chosen model, and check(), which verifies the key, model existence, tool support and remaining credit.",
      "tags": [
        "factory",
        "config",
        "validation",
        "integration"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:src/server.mjs",
      "type": "file",
      "name": "server.mjs",
      "filePath": "src/server.mjs",
      "summary": "Trident's entry point: a local HTTP server bound to 127.0.0.1 that wires together the gate, Codex, OpenRouter, Library, settings and workplaces, streams every event to the page over server-sent events, and handles the POST routes for workplaces, messages, approvals, plans, interrupts, Library actions and settings.",
      "tags": [
        "entry-point",
        "api-handler",
        "http-server",
        "server-sent-events",
        "composition-root"
      ],
      "complexity": "moderate",
      "languageNotes": "Uses Node's built-in http module with a hand-written if/else router instead of a framework, and an in-memory history array replayed to each new SSE client."
    },
    {
      "id": "function:src/server.mjs:emit",
      "type": "function",
      "name": "emit",
      "filePath": "src/server.mjs",
      "lineRange": [
        32,
        40
      ],
      "summary": "Central event bus: timestamps an event, keeps non-delta events in history and the JSONL transcript, and pushes it to every connected server-sent-events client.",
      "tags": [
        "event-handler",
        "logging",
        "server-sent-events"
      ],
      "complexity": "simple"
    },
